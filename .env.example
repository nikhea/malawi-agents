# Malawi Store API base URL, including the /api/v1 prefix.
MALAWI_API_BASE_URL=http://localhost:8080/api/v1

# Local-development identity. When set (and NODE_ENV is not "production"),
# tools and the auth middleware use these instead of a real Authorization
# header — handy for Studio's tool playground. Leave empty in production.
MALAWI_TOKEN=
MALAWI_REFRESH_TOKEN=

# Model provider key used by the example agent.
GROQ_API_KEY=

# Mastra main storage (PostgreSQL): threads, messages, workflows, memory.
# MASTRA_DATABASE_URL takes precedence; DATABASE_URL is accepted as a fallback.
MASTRA_DATABASE_URL=postgresql://user:password@localhost:5432/malawi_agents?sslmode=disable

# Observability storage (DuckDB): traces, logs, metrics, scores, feedback.
DUCKDB_PATH=mastra.duckdb
DUCKDB_MEMORY_LIMIT=2GB

# Distributed pub/sub (Redis Streams).
REDIS_URL=redis://localhost:6379/0
REDIS_PUBSUB_KEY_PREFIX=mastra:topic
# How long an idle stream survives, in milliseconds. Defaults to 7 days.
REDIS_STREAM_IDLE_TTL_MS=604800000

# Logging and trace metadata.
MASTRA_LOG_LEVEL=info
MASTRA_SERVICE_NAME=malawi-agents
